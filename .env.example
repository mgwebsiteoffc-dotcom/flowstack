APP_NAME="Task365"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=Asia/Kolkata
APP_URL=http://localhost:8000

# Base domain under which every agency gets {slug}.yoursaas.com
TENANT_DOMAIN=yoursaas.com
# Local dev convenience: fall back to the first active tenant when no subdomain is present
TENANT_FALLBACK_SINGLE=true

LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=agency_os
DB_USERNAME=root
DB_PASSWORD=

# For local verification without MySQL you may use sqlite:
# DB_CONNECTION=sqlite
# DB_DATABASE=/absolute/path/to/database.sqlite

SESSION_DRIVER=database
SESSION_LIFETIME=120
# MUST be false (or unset) when testing over http://127.0.0.1 - a Secure cookie
# is never sent over plain HTTP, so logins never persist (you stay on the login
# page). Set true only when serving over HTTPS in production.
SESSION_SECURE_COOKIE=false
CACHE_DRIVER=file
QUEUE_CONNECTION=database

FILESYSTEM_DISK=local

# Gmail SMTP - enable 2-Step Verification, then create an App Password
# (Google Account > Security > App passwords) and paste it below.
MAIL_MAILER=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your.email@gmail.com
MAIL_PASSWORD=your-16-char-app-password
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="your.email@gmail.com"
MAIL_FROM_NAME="Task365"

RAZORPAY_KEY=
RAZORPAY_SECRET=

SUPER_ADMIN_EMAIL=superadmin@task365.test
SUPER_ADMIN_PASSWORD=ChangeMe123!

TRIAL_GRACE_DAYS=30
WEBHOOK_LOG_RETENTION_DAYS=90

BIKRIBOOK_BASE_URL=https://api.bikribook.com/v1

# Slack / Microsoft Teams channel notifications (incoming webhooks)
SLACK_WEBHOOK_URL=
TEAMS_WEBHOOK_URL=

# Google Calendar sync + Google Meet generation (OAuth 2.0)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://127.0.0.1:8000/settings/integrations/google-calendar/callback

# OpenRouter (AI task generator) — https://openrouter.ai
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=nvidia/nemotron-3.5-lightning:free

VITE_APP_NAME="${APP_NAME}"

# ---- Public website brand ----
BRAND_COLOR=#4f46e5
BRAND_COLOR_SECONDARY=
BRAND_HERO_1=Run Your Agency
BRAND_HERO_2=on Autopilot
BRAND_HERO_SUB=Replace guesswork and scattered spreadsheets with real-time agency intelligence. One platform for Clients, Projects, Tasks, Leads, Invoices and Reporting. Built for agencies of any size.
# Real dashboard screenshots (drop files into public/screenshots/):
BRAND_DASHBOARD_SCREENSHOT=
BRAND_SCREENSHOT_CLIENTS=
BRAND_SCREENSHOT_TASKS=
BRAND_SCREENSHOT_LEADS=
BRAND_SCREENSHOT_FINANCE=
