; Agency OS - Supervisor configuration example
; Place in /etc/supervisor/conf.d/agency-os.conf and run:
;   sudo supervisorctl reread && sudo supervisorctl update

[program:agency-os-queue]
process_name=%(program_name)s_%(process_num)02d
command=php /var/www/agency-os/artisan queue:work database --tries=3 --max-time=3600
autostart=true
autorestart=true
stopasgroup=true
killasgroup=true
user=www-data
numprocs=2
redirect_stderr=true
stdout_logfile=/var/www/agency-os/storage/logs/queue-worker.log
stopwaitsecs=3600

[program:agency-os-scheduler]
command=php /var/www/agency-os/artisan schedule:work
autostart=true
autorestart=true
user=www-data
redirect_stderr=true
stdout_logfile=/var/www/agency-os/storage/logs/scheduler.log
